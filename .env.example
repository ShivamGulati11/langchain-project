# ── Application ──────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=changeme-use-a-long-random-string-in-production
LOG_LEVEL=INFO
DEBUG=true

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://loce:loce@localhost:5432/loce
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Webhook HMAC Secrets (per-partner) ───────────────────
WEBHOOK_HMAC_SECRET_MSG91=changeme-msg91
WEBHOOK_HMAC_SECRET_KARIX=changeme-karix
WEBHOOK_HMAC_SECRET_EXOTEL=changeme-exotel
WEBHOOK_HMAC_SECRET_SENDGRID=changeme-sendgrid
WEBHOOK_HMAC_SECRET_NETCORE=changeme-netcore

# ── NBFC Adapter credentials ─────────────────────────────
NBFC_A_BASE_URL=https://api.nbfc-a.example.com
NBFC_A_API_KEY=changeme-nbfc-a
NBFC_B_BASE_URL=https://api.nbfc-b.example.com
NBFC_B_API_KEY=changeme-nbfc-b
NBFC_C_BASE_URL=https://api.nbfc-c.example.com
NBFC_C_API_KEY=changeme-nbfc-c
NBFC_DEFAULT_TIMEOUT_SECONDS=10
NBFC_DEFAULT_QPS=10

# ── Communication Partners ────────────────────────────────
MSG91_AUTH_KEY=changeme-msg91-auth
KARIX_API_KEY=changeme-karix
KARIX_API_SECRET=changeme-karix-secret
EXOTEL_SID=changeme-exotel-sid
EXOTEL_TOKEN=changeme-exotel-token
SENDGRID_API_KEY=changeme-sendgrid
NETCORE_API_KEY=changeme-netcore

# ── AWS / KMS (optional) ─────────────────────────────────
AWS_REGION=ap-south-1
AWS_KMS_KEY_ARN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── OpenTelemetry ─────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=loce

# ── Rate Limiter defaults ────────────────────────────────
DEFAULT_RATE_LIMIT_QPS=10
DEFAULT_RATE_LIMIT_BURST=20

# ── JWT ───────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
